{
  "schemaVersion": 1,
  "id": "chrc",
  "version": "${version}",
  "name": "Crystal Hollow Route Checker",
  "description": "Client-side Crystal Hollows gemstone route checker with Skyblocker waypoint import.",
  "authors": ["quangvan"],
  "environment": "client",
  "mixins": [
    "chrc.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "dev.chrc.CHRCClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.152.1+26.1.2",
    "minecraft": "~26.1",
    "java": ">=25"
  }
}
